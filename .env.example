# Copy to .env and fill in (never commit .env)

# Required — Apigee account (usually your email)
APIGEE_USERNAME=you@company.com
APIGEE_PASSWORD=your-apigee-password

# Optional defaults
APIGEE_ORG=your-org-name
APIGEE_TOKEN_URL=https://login.apigee.com/oauth/token

# SAML zone example:
# APIGEE_TOKEN_URL=https://YOUR-ZONE.login.apigee.com/oauth/token

# MFA (when enabled on your account) — append as query on token URL
# APIGEE_MFA_TOKEN=123456

# Rarely needed (default is Apigee doc value)
# APIGEE_CLIENT_BASIC=ZWRnZWNsaTplZGdlY2xpc2VjcmV0

# Set true to make /healthz return 503 when token exchange fails
# APIGEE_HEALTH_CHECK_TOKEN=true
